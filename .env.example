# JHST Journal SMTP Configuration Template
# Instructions:
# 1. Copy this file and rename it to ".env"
# 2. Fill in your actual mail server details
# 3. For Gmail, you MUST use an "App Password", not your regular password.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-24-character-app-password
DEFAULT_FROM_EMAIL=Journal of Hydrocarbon Science and Technology <your-email@gmail.com>

# JHST Crossref DOI Registration (https://doi.crossref.org/servlet/submissionAdmin)
# Role: bcmg. NEVER commit real values — copy this template to .env and fill in.
# Start with CROSSREF_USE_TEST=True (safe dry runs on the test server).
CROSSREF_LOGIN_ID=your-crossref-login-email@example.com
CROSSREF_LOGIN_PASSWORD=your-crossref-password
CROSSREF_DEPOSITOR_EMAIL=your-crossref-login-email@example.com
CROSSREF_USE_TEST=True
CROSSREF_SITE_URL=https://www.jhst.org
